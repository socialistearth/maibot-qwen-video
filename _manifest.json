{
  "manifest_version": 2,
  "id": "local.qwen-bilibili-video-context",
  "version": "1.4.0",
  "name": "Qwen B站与QQ视频理解",
  "description": "使用Qwen-Omni理解B站链接及QQ群、私聊中直接发送的视频，沿用白名单、缓存和完整画面与音轨识别。",
  "author": {
    "name": "socialistearth",
    "url": "https://github.com/socialistearth"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/socialistearth/maibot-qwen-video",
    "homepage": "https://github.com/socialistearth/maibot-qwen-video",
    "documentation": "https://github.com/socialistearth/maibot-qwen-video/blob/main/README.md",
    "issues": "https://github.com/socialistearth/maibot-qwen-video/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.3.5",
    "max_version": "1.3.999"
  },
  "sdk": {
    "min_version": "2.10.0",
    "max_version": "2.999.999"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.12.14,<4"
    }
  ],
  "capabilities": [
    "send.text",
    "api.call"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "display": {
    "icon": {
      "type": "lucide",
      "value": "video",
      "fallback": "plug",
      "background": "#FB7299"
    }
  }
}
